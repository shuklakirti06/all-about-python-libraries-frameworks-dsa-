   "source": [
    "import numpy as np\n",
    "\n",
    "arr1 = np.array([10, 20, 30, 40])\n",
    "arr2 = np.array([2, 4, 5, 8])\n",
    "\n",
    "# Addition\n",
    "arr1 + arr2\n",
    "\n",
    "# Subtraction\n",
    "arr1 - arr2\n",
    "\n",
    "# Multiplication\n",
    "arr1 * arr2\n",
    "\n",
    "# Division\n",
    "arr1 / arr2\n",
    "\n",
    "# Power\n",
    "arr1 ** 2\n",
    "\n",
    "# Modulus (remainder)\n",
    "arr1 % arr2\n",
    "\n",
    "# Comparison\n",
    "arr1 > 20"
   ]
